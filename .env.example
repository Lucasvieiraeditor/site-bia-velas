# ═══════════════════════════════════════════════════════════════════════════
# BIA VELAS AROMÁTICAS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────────────
# Obtenha em: https://supabase.com > Seu Projeto > Settings > API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# ── MercadoPago ──────────────────────────────────────────────────────────────
# Endpoint do seu backend/Edge Function que cria preferências de pagamento.
# Veja /supabase/functions/create-preference (template incluído abaixo).
# Obtenha suas credenciais em: https://www.mercadopago.com.br/developers
VITE_CHECKOUT_API_URL=https://SEU_PROJETO.supabase.co/functions/v1/create-preference
